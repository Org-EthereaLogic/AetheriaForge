# =============================================================================
# AetheriaForge — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Databricks workspace (required for bundle commands and deployment)
# Set CATALOG at minimum; SCHEMA and VOLUME default to sensible values.
# -----------------------------------------------------------------------------
CATALOG=your-unity-catalog-name
SCHEMA=default
VOLUME=aetheriaforge_runtime

# Databricks CLI profile (optional — omit to use the default workspace)
PROFILE=

# Bundle variable aliases (override CATALOG/SCHEMA when set)
BUNDLE_VAR_catalog=

# -----------------------------------------------------------------------------
# Runtime paths (injected by Databricks app at deploy time;
# set locally to point at local volume mounts during development)
# -----------------------------------------------------------------------------
CONTRACTS_DIR=
EVIDENCE_DIR=

# -----------------------------------------------------------------------------
# CI / Code quality tokens (used in GitHub Actions secrets — not needed locally)
# -----------------------------------------------------------------------------
# CODECOV_TOKEN=
# SNYK_PROJECT_TOKEN=
